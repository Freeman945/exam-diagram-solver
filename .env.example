# exam-diagram-solver does NOT require any API key of its own.
#
# Model calls go through the DeepSeek Harness `llm` service and use the model
# already configured in the Harness profile. Nothing is read from this file at
# runtime; it only documents the optional environment variables the plugin
# understands.

# Path to a Python 3.10+ interpreter that has SymPy installed.
# If unset, the plugin probes (in order): plugin config `pythonPath`,
# this variable, <repo>/.venv, `python`, `python3`, `py`.
EXAM_SOLVER_PYTHON=

# Where generated diagrams and run records are written.
# Defaults to the OS temp directory: %TEMP%\exam-diagram-solver
# Never put this inside the repository if you plan to commit photos.
EXAM_SOLVER_OUTPUT_DIR=

# Optional: override the JSON-schema directory (only for packaged deployments).
EXAM_SOLVER_SCHEMA_DIR=
