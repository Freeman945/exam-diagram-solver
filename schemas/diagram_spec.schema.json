{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-diagram-solver.dev/schemas/diagram_spec.schema.json",
  "title": "DiagramSpec",
  "description": "Declarative drawing description. The model decides WHAT to draw; the renderer decides HOW to draw it. Every variant is strict: unknown fields are rejected after sanitization.",
  "type": "object",
  "$defs": {
    "point2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "pair": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "maxItems": 2
    },
    "label": { "type": "string" },
    "style": { "enum": ["solid", "dashed", "dotted"] },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": { "const": "geometry" },
        "title": { "type": "string" },
        "points": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/point2" },
          "minProperties": 1
        },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "auxiliary_segments": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "rays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
          }
        },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "polygons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["points"],
            "properties": {
              "points": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
              "fill": { "type": "string" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "circles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center"],
            "properties": {
              "center": { "type": "string" },
              "radius": { "type": "number" },
              "through": { "type": "string" },
              "label": { "type": "string" },
              "style": { "$ref": "#/$defs/style" }
            },
            "oneOf": [{ "required": ["radius"] }, { "required": ["through"] }]
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center", "radius", "start_angle", "end_angle"],
            "properties": {
              "center": { "type": "string" },
              "radius": { "type": "number" },
              "start_angle": { "type": "number" },
              "end_angle": { "type": "number" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "at"],
                "properties": {
                  "type": { "const": "right_angle" },
                  "at": { "type": "string" },
                  "arms": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "segments"],
                "properties": {
                  "type": { "const": "equal_length" },
                  "segments": { "type": "array", "items": { "$ref": "#/$defs/pair" }, "minItems": 1 },
                  "tick": { "type": "integer", "minimum": 1, "maximum": 3 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "segments"],
                "properties": {
                  "type": { "const": "parallel" },
                  "segments": { "type": "array", "items": { "$ref": "#/$defs/pair" }, "minItems": 1 },
                  "tick": { "type": "integer", "minimum": 1, "maximum": 3 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "at"],
                "properties": {
                  "type": { "const": "angle" },
                  "at": { "type": "string" },
                  "arms": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
                  "label": { "type": "string" }
                }
              }
            ]
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "label_offsets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/point2" }
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["coordinate", "function"] },
        "title": { "type": "string" },
        "expression": { "type": "string", "description": "For type=function only: y = f(x) in SymPy notation." },
        "variable": { "type": "string" },
        "domain": { "$ref": "#/$defs/point2" },
        "x_range": { "$ref": "#/$defs/point2" },
        "y_range": { "$ref": "#/$defs/point2" },
        "curves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expr"],
            "properties": {
              "expr": { "type": "string" },
              "variable": { "type": "string" },
              "domain": { "$ref": "#/$defs/point2" },
              "label": { "type": "string" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "label": { "type": "string" },
              "style": { "enum": ["filled", "open"] }
            }
          }
        },
        "guides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/point2" },
              "to": { "$ref": "#/$defs/point2" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "grid": { "type": "boolean" },
        "axis_labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x": { "type": "string" }, "y": { "type": "string" } }
        },
        "mark_key_points": { "type": "boolean", "description": "Annotate SymPy-derived roots, vertex/extrema and intercepts." }
      }
    },
    "force": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "forces"],
      "properties": {
        "type": { "const": "force" },
        "title": { "type": "string" },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": { "enum": ["block", "dot", "incline"] },
            "label": { "type": "string" }
          }
        },
        "incline_angle": { "type": "number" },
        "forces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "angle_deg"],
            "properties": {
              "label": { "type": "string" },
              "angle_deg": { "type": "number", "description": "0 = +x (right), 90 = up. Direction must come from the physics solution." },
              "magnitude": { "type": "number" },
              "unit": { "type": "string" },
              "style": { "enum": ["solid", "dashed"] },
              "origin": { "$ref": "#/$defs/point2" }
            }
          }
        },
        "velocity": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "label": { "type": "string" }, "angle_deg": { "type": "number" } }
        },
        "acceleration": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "label": { "type": "string" }, "angle_deg": { "type": "number" } }
        },
        "axes": { "type": "boolean" },
        "coordinate_note": { "type": "string" }
      }
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "components"],
      "properties": {
        "type": { "const": "circuit" },
        "title": { "type": "string" },
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/point2" },
          "description": "Optional explicit positions. Omit to let the renderer lay out the topology automatically."
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "from", "to"],
            "properties": {
              "kind": {
                "enum": [
                  "battery",
                  "resistor",
                  "ammeter",
                  "voltmeter",
                  "switch",
                  "lamp",
                  "capacitor",
                  "inductor",
                  "rheostat"
                ]
              },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": "string" },
              "polarity": { "enum": ["normal", "reversed"] }
            }
          }
        },
        "current_arrows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "optics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "surfaces", "rays"],
      "properties": {
        "type": { "const": "optics" },
        "title": { "type": "string" },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "from", "to"],
            "properties": {
              "kind": { "enum": ["mirror", "interface", "lens", "screen"] },
              "from": { "$ref": "#/$defs/point2" },
              "to": { "$ref": "#/$defs/point2" },
              "label": { "type": "string" }
            }
          }
        },
        "rays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["points"],
            "properties": {
              "points": { "type": "array", "items": { "$ref": "#/$defs/point2" }, "minItems": 2 },
              "label": { "type": "string" },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "$ref": "#/$defs/point2" }, "to": { "$ref": "#/$defs/point2" } }
          }
        },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": { "from": { "$ref": "#/$defs/point2" }, "to": { "$ref": "#/$defs/point2" } }
        },
        "focal_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at"],
            "properties": { "at": { "$ref": "#/$defs/point2" }, "label": { "type": "string" } }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "text"],
            "properties": {
              "at": { "$ref": "#/$defs/point2" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "series"],
      "properties": {
        "type": { "const": "chart" },
        "title": { "type": "string" },
        "kind": { "enum": ["line", "bar", "scatter"] },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["points"],
            "properties": {
              "label": { "type": "string" },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1
              }
            }
          }
        },
        "x_label": { "type": "string" },
        "y_label": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/geometry" },
    { "$ref": "#/$defs/coordinate" },
    { "$ref": "#/$defs/force" },
    { "$ref": "#/$defs/circuit" },
    { "$ref": "#/$defs/optics" },
    { "$ref": "#/$defs/chart" }
  ]
}
